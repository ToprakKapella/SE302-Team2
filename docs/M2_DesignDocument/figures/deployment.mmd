  CSV[("CSV files<br/>on local disk")] -- "File > Import" --> INST["ExamScheduler/<br/>app/exam-scheduler.jar<br/>runtime/ (Java + JavaFX)"]
end
SRC -- "push tag or Run workflow" --> CI
CI --> EXE
